# Server
PORT=5000

# MySQL Database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=loan_management
DB_PORT=3306

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Super Admin (created automatically on first run if not present)
# This is the top-level account that creates and manages Companies.
SUPER_ADMIN_EMAIL=super@loanapp.com
SUPER_ADMIN_PASSWORD=SuperAdmin@12345
SUPER_ADMIN_NAME=Super Admin
